<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CourtCase CrossBrowser Suite" parallel="tests" thread-count="2">

  <test name="CourtCase-Chrome">
    <parameter name="browser" value="chrome"/>
    <classes>
      <class name="com.ebid.lcs.tests.CourtCaseTest"/>
    </classes>
  </test>

  <test name="CourtCase-Edge">
    <parameter name="browser" value="edge"/>
    <classes>
      <class name="com.ebid.lcs.tests.CourtCaseTest"/>
    </classes>
  </test>

</suite>
