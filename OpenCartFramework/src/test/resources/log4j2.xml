<?xml version="1.0" encoding="UTF-8"?>

<!-- Bind to grammar/schema -->
<Configuration status="WARN">

    <Properties>
        <Property name="basePath">./logs</Property>  <!--by default path > logs folder in project-basepth store path-basepath can be anything-->
    </Properties>

    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <RollingFile name="File"
                     fileName="${basePath}/automation.log"
                     filePattern="${basePath}/automation-%d{yyyy-MM-dd}.log">   <!--timestmap created-->

            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
            <SizeBasedTriggeringPolicy size="5000"/>
        </RollingFile>

    </Appenders>

    <Loggers>
        <Root level="Debug">      <!--level of logs > all>trace>debug>error>warn>fatal>off-->
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>

</Configuration>
