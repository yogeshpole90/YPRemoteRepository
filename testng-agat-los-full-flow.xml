<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AGAT LOS - Full E2E Flow (Lead + DDE + Credit + Offer)" verbose="1">

    <test name="Full E2E Flow">
        <classes>
            <!-- Stage 1: Lead Creation (login as n.namozov via @BeforeSuite) -->
            <class name="com.agat.los.tests.stage01_lead.LeadCreationTest"/>

            <!-- Stage 2: DDE -->
            <class name="com.agat.los.tests.stage02_dataentry.BasicDetailsTest"/>
            <class name="com.agat.los.tests.stage02_dataentry.AddressTest"/>
            <class name="com.agat.los.tests.stage02_dataentry.IdentificationTest"/>
            <class name="com.agat.los.tests.stage02_dataentry.EmploymentTest">
                <methods><exclude name="navigateToApplication"/></methods>
            </class>
            <class name="com.agat.los.tests.stage02_dataentry.BankDetailsTest">
                <methods><exclude name="navigateToApplication"/></methods>
            </class>
            <class name="com.agat.los.tests.stage02_dataentry.ReferenceDetailsTest">
                <methods><exclude name="navigateToApplication"/></methods>
            </class>
            <class name="com.agat.los.tests.stage02_dataentry.ProductDetailsTest">
                <methods><exclude name="navigateToApplication"/></methods>
            </class>
            <class name="com.agat.los.tests.stage02_dataentry.CollateralTest">
                <methods><exclude name="navigateToApplication"/></methods>
            </class>
            <class name="com.agat.los.tests.stage02_dataentry.IncomeTest">
                <methods><exclude name="navigateToApplication"/></methods>
            </class>
            <class name="com.agat.los.tests.stage02_dataentry.ExpenseTest">
                <methods><exclude name="navigateToApplication"/></methods>
            </class>
            <class name="com.agat.los.tests.stage02_dataentry.CreditBureauTest">
                <methods><exclude name="navigateToApplication"/></methods>
            </class>
            <class name="com.agat.los.tests.stage02_dataentry.DocumentTest">
                <methods><exclude name="navigateToApplication"/></methods>
            </class>
            <class name="com.agat.los.tests.stage02_dataentry.PolicyReviewTest">
                <methods><exclude name="navigateToApplication"/></methods>
            </class>
            <class name="com.agat.los.tests.stage02_dataentry.StageTransitionTest">
                <methods><exclude name="navigateToApplication"/></methods>
            </class>

            <!-- Stage 3: Credit Approval (logout n.namozov → login s.shasultonov) -->
            <class name="com.agat.los.tests.stage04_credit.CreditApprovalTest"/>

            <!-- Stage 4: Offer Acceptance (logout s.shasultonov → login n.namozov) -->
            <class name="com.agat.los.tests.stage05_offer.OfferAcceptanceTest"/>

            <!-- Stage 5: Loan Activation (login n.namozov) -->
            <class name="com.agat.los.tests.stage05_loanactivation.LoanActivationTest"/>
        </classes>
    </test>

</suite>
